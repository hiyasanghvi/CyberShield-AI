# Backend
DATABASE_URL=mysql+pymysql://USERNAME:PASSWORD@localhost:3306/cybershield
SECRET_KEY=change_this_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Generate with: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
DATA_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_32_BYTE_BASE64_KEY
# Set true only after applying backend/scripts/privacy_encryption_mysql.sql,
# running encrypt_existing_data.py, and verifying deployment TLS termination.
DATA_ENCRYPTION_MIGRATION_COMPLETE=false
ENFORCE_HTTPS=false

# Backend CORS (comma-separated frontend origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
